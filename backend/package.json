{
  "name": "healthybe-server",
  "version": "1.1.0",
  "description": "HealthyBe family health records API with Gemini chat",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src scripts eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" eslint.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@google/genai": "^2.29.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "mongoose": "^9.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
